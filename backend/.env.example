# Copy this file to .env and fill in real values. Never commit .env.
#
# More variables (email provider, image storage) will be added here as
# those phases of the project are implemented.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=lirios_saas
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Sandbox mode ignores these and uses PixelPay's own published sandbox
# credentials (see payments/services.py). Set PIXELPAY_SANDBOX=False and
# fill these in with real merchant credentials to charge for real.
PIXELPAY_SANDBOX=True
PIXELPAY_AUTH_KEY=
PIXELPAY_AUTH_HASH=
PIXELPAY_ENDPOINT=https://pixelpay.app
