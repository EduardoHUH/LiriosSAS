# Copy this file to .env and fill in real values. Never commit .env.
#
# More variables (email provider, image storage) will be added here as
# those phases of the project are implemented.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=lirios_saas
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173

FRONTEND_URL=http://localhost:5173

# Test-mode keys from the Stripe dashboard. STRIPE_WEBHOOK_SECRET comes
# from `stripe listen` (Stripe CLI) locally, or the dashboard once a live
# webhook endpoint is configured.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
