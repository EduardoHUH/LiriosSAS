# Copy this file to .env and fill in real values. Never commit .env.
#
# More variables (image storage) will be added here as those phases of
# the project are implemented.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=lirios_saas
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Needed for the Django admin's own login form once this is deployed behind
# real HTTPS -- leave blank for local dev. Set to the real backend URL(s),
# e.g. https://your-app.up.railway.app
CSRF_TRUSTED_ORIGINS=

FRONTEND_URL=http://localhost:5173

# Leave SENDGRID_API_KEY blank to use the console backend (emails print to
# the runserver log instead of sending) -- fine for local dev.
DEFAULT_FROM_EMAIL=Lirios <no-reply@lirios.hn>
SENDGRID_API_KEY=
